# Line endings are normalised in the index and written native on checkout.
# The working tree is Windows; without this every commit warns per file.
* text=auto

# Unity YAML and shader sources are text and diff usefully.
*.cs        text diff=csharp
*.shader    text
*.cginc     text
*.hlsl      text
*.md        text
*.sh        text eol=lf
*.asset     text
*.anim      text
*.controller text
*.mat       text
*.prefab    text
*.unity     text
*.meta      text

# Binary: never normalised, never diffed as text.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.psd           binary
*.fbx           binary
*.unitypackage  binary
*.dll           binary
*.ttf           binary
*.otf           binary
