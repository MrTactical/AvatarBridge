/* AvatarBridge — window stylesheet.
 *
 * Shape and spacing follow the two panels this window sits beside: the CCK's rounded 1px-bordered
 * cards, and the VRChat SDK's header fills and 3/6/14/24 spacing scale. Colours that exist as
 * Unity design tokens use the token, so both editor skins work without a second palette; the
 * .dark / .light classes on the root cover the rest, which is how the VRChat SDK does it too.
 *
 * Gradients are absent on purpose — USS has no gradient support in any current Unity, so those
 * are generated textures assigned from BridgeTheme.
 */

/* ---------------------------------------------------------------- root ---- */

.ab-root {
    flex-grow: 1;
}

.ab-scroll {
    flex-grow: 1;
    padding: 6px 8px 10px 8px;
}

/* -------------------------------------------------------------- banner ---- */

.ab-banner {
    height: 62px;
    flex-shrink: 0;
    -unity-background-scale-mode: stretch-to-fill;
    justify-content: center;
    padding-left: 14px;
    padding-right: 12px;
    flex-direction: row;
    align-items: center;
}

.ab-banner-text {
    flex-grow: 1;
    justify-content: center;
}

.ab-banner-title {
    font-size: 19px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin: 0;
    padding: 0;
}

.ab-banner-sub {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.78);
    margin: 2px 0 0 1px;
    padding: 0;
}

.ab-version {
    background-color: rgba(0, 0, 0, 0.26);
    border-radius: 9px;
    padding: 2px 9px;
    font-size: 10px;
    color: rgba(255, 255, 255, 0.95);
    flex-shrink: 0;
}

/* ---------------------------------------------------------------- tabs ---- */

.ab-tabs {
    flex-direction: row;
    height: 28px;
    margin: 6px 8px;
    padding: 2px;
    border-width: 1px;
    border-radius: 5px;
    border-color: var(--unity-colors-button-border);
    flex-shrink: 0;
}

.ab-tab {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    border-radius: 3px;
    transition-property: background-color;
    transition-duration: 0.09s;
}

.ab-tab-icon {
    width: 14px;
    height: 14px;
    margin-right: 5px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--unity-colors-default-text);
}

.ab-tab > .unity-label {
    font-size: 11px;
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

.dark .ab-tab:hover {
    background-color: rgba(255, 255, 255, 0.06);
}

.light .ab-tab:hover {
    background-color: rgba(0, 0, 0, 0.05);
}

.ab-tab-on > .unity-label {
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.ab-tab-on > .ab-tab-icon {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

/* --------------------------------------------------------------- cards ---- */

.ab-card {
    border-width: 1px;
    border-radius: 5px;
    margin-bottom: 6px;
    overflow: hidden;
    flex-shrink: 0;
}

.dark .ab-card {
    border-color: rgba(0, 0, 0, 0.55);
}

.light .ab-card {
    border-color: rgba(0, 0, 0, 0.22);
}

.ab-card-header {
    flex-direction: row;
    align-items: center;
    padding: 6px 9px;
    min-height: 24px;
}

.dark .ab-card-header {
    background-color: rgb(60, 60, 60);
}

.light .ab-card-header {
    background-color: rgb(203, 203, 203);
}

.ab-card-header {
    transition-property: background-color;
    transition-duration: 0.09s;
}

.dark .ab-card-collapsible:hover > .ab-card-header {
    background-color: rgb(71, 71, 71);
}

.light .ab-card-collapsible:hover > .ab-card-header {
    background-color: rgb(213, 213, 213);
}

/* Unity ships a pale arrow and a dark one; picking the wrong one loses it entirely against
 * the header. Selected per skin rather than hardcoded, so both themes keep an arrow. */
.ab-card-arrow {
    width: 13px;
    height: 13px;
    margin-right: 4px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* Underscores, not spaces. "d_IN foldout" doesn't resolve and Unity substitutes a warning
 * triangle, which looked like the card was reporting a problem. The CCK gets this right and
 * this is its spelling. */
.dark .ab-card-arrow {
    background-image: resource('d_IN_foldout@2x');
}

.light .ab-card-arrow {
    background-image: resource('IN_foldout@2x');
}

.dark .ab-card-arrow-on {
    background-image: resource('d_IN_foldout_on@2x');
}

.light .ab-card-arrow-on {
    background-image: resource('IN_foldout_on@2x');
}

.ab-card-title {
    -unity-font-style: bold;
    font-size: 12px;
    flex-grow: 1;
    margin: 0;
    padding: 0;
}

.ab-card-summary {
    font-size: 10px;
    -unity-text-align: middle-right;
    flex-shrink: 1;
    margin: 0;
    padding: 0;
}

.ab-card-body {
    padding: 8px 9px 9px 9px;
}

.dark .ab-card-body {
    background-color: rgba(255, 255, 255, 0.028);
}

.light .ab-card-body {
    background-color: rgba(0, 0, 0, 0.022);
}

/* --------------------------------------------------------------- steps ---- */

.ab-step-badge {
    width: 19px;
    height: 19px;
    border-radius: 10px;
    margin-right: 8px;
    flex-shrink: 0;
    -unity-background-scale-mode: stretch-to-fill;
    align-items: center;
    justify-content: center;
}

.ab-step-badge > .unity-label {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin: 0;
    padding: 0;
}

/* Secondary text, set here rather than inline in C# so switching editor theme is handled by
 * the cascade instead of by a colour sampled once when the element was built. */
.dark .ab-card-summary,
.dark .ab-sub,
.dark .ab-hint {
    color: rgba(255, 255, 255, 0.50);
}

.light .ab-card-summary,
.light .ab-sub,
.light .ab-hint {
    color: rgba(0, 0, 0, 0.55);
}

/* ------------------------------------------------------------ controls ---- */

/* Group headings carry a hairline, which is what stops the Advanced card reading as one
 * undifferentiated wall of twenty checkboxes. */
.ab-sub {
    font-size: 9px;
    -unity-font-style: bold;
    margin: 11px 0 4px 0;
    padding: 0 0 3px 0;
    border-bottom-width: 1px;
}

.dark .ab-sub {
    border-bottom-color: rgba(255, 255, 255, 0.07);
}

.light .ab-sub {
    border-bottom-color: rgba(0, 0, 0, 0.08);
}

.ab-hint {
    font-size: 10px;
    white-space: normal;
    margin: 0 0 4px 1px;
    padding: 0;
}

.ab-row {
    flex-direction: row;
    align-items: center;
}

/* Checkbox first, then the label — so a column of toggles has its boxes aligned instead of
 * scattered at the end of each label. UI Toolkit's Toggle is a BaseField and puts the label
 * first; the CCK hits the same problem and reverses the row, which is what this is. */
.ab-toggle {
    flex-direction: row-reverse;
    justify-content: flex-end;
    margin: 0 0 0 -4px;
    padding: 2px 4px;
    border-radius: 3px;
    transition-property: background-color;
    transition-duration: 0.09s;
}

/* The row lights up under the cursor, so it's obvious which of twenty toggles you're about
 * to hit — the checkbox alone is a small target to aim at. */
.dark .ab-toggle:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.light .ab-toggle:hover {
    background-color: rgba(0, 0, 0, 0.045);
}

.ab-toggle > .unity-toggle__input {
    flex-grow: 0;
    flex-shrink: 0;
    margin-right: 5px;
}

.ab-toggle > .unity-label {
    min-width: 0;
    flex-grow: 0;
    margin-left: 0;
    padding-left: 0;
}

.ab-field {
    margin: 2px 0;
}

/* A fixed width, not a minimum: with min-width the longest label in a card ("Convert PhysBones
 * to") pushed its own control right while every other field stayed put, so nothing lined up
 * down the column. */
.ab-field > .unity-label {
    width: 132px;
    min-width: 132px;
    flex-shrink: 0;
}

/* AAS menu entries carry longer names than the options cards ("Tail Electric Effect
 * Toggle", "Storage Upgrade: Upper"); the standard 132px column clips them. */
.ab-field-wide > .unity-label {
    width: 176px;
    min-width: 176px;
    flex-shrink: 0;
}

/* ----------------------------------------------------------- primary  ---- */

.ab-primary {
    height: 38px;
    border-radius: 5px;
    border-width: 0;
    margin: 4px 0 2px 0;
    -unity-background-scale-mode: stretch-to-fill;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.ab-primary > .unity-label {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin: 0;
    padding: 0;
}

/* Dimmed, but the label stays readable — at 0.4 on the whole element the text washed out
 * into the gradient and the button looked broken rather than waiting. */
.ab-primary-off {
    opacity: 0.55;
}

.ab-primary-off > .unity-label {
    color: rgba(255, 255, 255, 0.85);
}

/* -------------------------------------------------------------- chips ---- */

.ab-chip {
    border-radius: 3px;
    padding: 2px 7px;
    margin-right: 4px;
    font-size: 10px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.ab-beta {
    border-radius: 3px;
    padding: 1px 5px;
    margin-left: 6px;
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

/* ------------------------------------------------------------- footer ---- */

.ab-footer {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: var(--unity-colors-button-border);
    flex-wrap: wrap;
}

/* The report's buttons. Setting only size left them with Unity's stock fill and border, which
 * is what made them read as bolted on; these carry their own surface. */
.ab-btn {
    height: 24px;
    border-radius: 4px;
    border-width: 1px;
    padding: 0 12px;
    margin: 4px 6px 0 0;
    font-size: 11px;
    transition-property: background-color;
    transition-duration: 0.09s;
}

.dark .ab-btn {
    background-color: rgba(255, 255, 255, 0.09);
    border-color: rgba(0, 0, 0, 0.45);
    color: rgba(255, 255, 255, 0.88);
}

.light .ab-btn {
    background-color: rgba(0, 0, 0, 0.06);
    border-color: rgba(0, 0, 0, 0.22);
    color: rgba(0, 0, 0, 0.85);
}

.dark .ab-btn:hover {
    background-color: rgba(255, 255, 255, 0.16);
}

.light .ab-btn:hover {
    background-color: rgba(0, 0, 0, 0.12);
}

.ab-report-row {
    flex-direction: row;
    flex-wrap: wrap;
}

/* Clickable chips need to look clickable, and the selected one fills solid. */
.ab-chip-click {
    border-radius: 3px;
    transition-property: background-color;
    transition-duration: 0.09s;
}

.ab-report-list {
    max-height: 260px;
    margin-top: 5px;
    border-width: 1px;
    border-radius: 4px;
}

.dark .ab-report-list {
    border-color: rgba(0, 0, 0, 0.45);
}

.light .ab-report-list {
    border-color: rgba(0, 0, 0, 0.18);
}

/* An entry is a status stripe plus two lines of text, not one long sentence. Wrapping the
 * detail under its own heading is what makes a page of these skimmable. */
.ab-report-item {
    flex-direction: row;
    padding: 5px 7px 5px 0;
}

.dark .ab-report-item-alt {
    background-color: rgba(255, 255, 255, 0.030);
}

.light .ab-report-item-alt {
    background-color: rgba(0, 0, 0, 0.028);
}

.ab-report-stripe {
    width: 3px;
    border-radius: 2px;
    margin: 1px 7px 1px 5px;
    flex-shrink: 0;
}

.ab-report-head {
    font-size: 11px;
    -unity-font-style: bold;
    white-space: normal;
    margin: 0;
    padding: 0;
}

.ab-report-detail {
    font-size: 10px;
    white-space: normal;
    margin: 2px 0 0 0;
    padding: 0;
}

.dark .ab-report-detail {
    color: rgba(255, 255, 255, 0.58);
}

.light .ab-report-detail {
    color: rgba(0, 0, 0, 0.62);
}
